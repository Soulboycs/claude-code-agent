{
  "name": "nexus-agent",
  "version": "0.1.0",
  "description": "NEXUS AGENT - Desktop AI Coding Agent powered by Bun, Electron, and React",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Antigravity Pair",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "cli": "bun run ./bin/agent-cli",
    "server": "bun run ./src/server/index.ts",
    "test:bun": "bun test tests/",
    "test": "bun test tests/",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "deploy": "python scripts/deploy.py",
    "package": "electron-vite build && electron-builder --win dir",
    "package:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexus.agent",
    "productName": "NEXUS-AGENT",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
